{
  // Flutter 配置

  // 启用 Flutter LSP 功能
  "dart.enableLsp": true,
  "dart.enableSdkFormatter": true,
  "dart.lineLength": 100,

  // 分析选项
  "dart.analyzeAdditionalFiles": ["lib/**/*.dart"],
  "dart.excludeFolders": ["build/**", ".dart_tool/**", "ios/Pods/**"],

  // 自动完成
  "dart.completeFunctionCalls": true,
  "dart.closingLabels": true,
  "dart.insertArgumentPlaceholders": true,

  // 调试配置
  "dart.debugExternalPackageLibraries": false,
  "dart.debugSdkLibraries": false,

  // 测试配置
  "dart.testAdditionalArgs": ["--no-sound-null-safety"],

  // 代码检查
  "dart.analyzerAdditionalArgs": ["--enable-experiment", "null-safety"],

  // Flutter 特定配置
  "flutter.flutterSdkPath": "flutter",

  // 构建
  "dart.buildRunnerAdditionalArgs": ["--delete-conflicting-outputs"],

  // 编辑器配置
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.rulers": [100],

  // 文件关联
  "files.associations": {
    "*.dart": "dart"
  },

  // 排除文件
  "files.exclude": {
    "**/.dart_tool": true,
    "**/build": true
  },
  "search.exclude": {
    "**/.dart_tool": true,
    "**/build": true,
    "**/*.g.dart": true,
    "**/*.freezed.dart": true
  },

  // CMake 相关（项目中可能有）
  "cmake.ignoreCMakeListsMissing": true,
  "cSpell.words": ["prefs"]
}
